{
    servers {
        timeouts {
            read_header 15s
            read_body 60s
            idle 2m
        }
        max_header_size 128KB
    }
}

comments.leonzk.cn {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Content-Security-Policy "base-uri 'self'; object-src 'none'; frame-ancestors 'self' https://leonzk.cn https://www.leonzk.cn http://localhost:4321"
    }
    request_body {
        max_size 1MiB
    }
    reverse_proxy 127.0.0.1:23366 {
        max_fails 1
        unhealthy_request_count 64
        transport http {
            dial_timeout 3s
            response_header_timeout 30s
            max_conns_per_host 64
        }
    }
}
