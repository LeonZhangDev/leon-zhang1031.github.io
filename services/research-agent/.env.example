# Copy to services/research-agent/.env.local; fill locally, never paste keys into chat.
# Normal startup stays mock/offline even after filling keys. Do not enable until confirmed.
AGENT_MODE=mock
AGENT_TRACE_MODE=offline
AGENT_TRIAL_BUDGET_YUAN=5
# Additional validation allowance, INSIDE the original cumulative 5 yuan.
# Persists across restarts and mode changes; allowed range >0 and <=0.5.
AGENT_VALIDATION_BUDGET_YUAN=0.5
AGENT_PORT=4322
# Keep the existing data directory; the cumulative trial ledger lives in its SQLite DB.
# AGENT_DATA_DIR=

DASHSCOPE_API_KEY=
# Beijing generic endpoint; a Beijing workspace MaaS compatible endpoint also works.
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-flash
# Before future testing, recheck: Beijing input CNY0.8/M, output CNY2.7/M (<=1M input).
# Code reserves standard price without cache discounts; thinking and built-in search stay off.
QWEN_PRICING_CONFIRMED=false

LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=private-research-agent-dev
# Required when the key spans more than one workspace.
LANGSMITH_WORKSPACE_ID=
# Confirm Developer plan, remaining free quota and disabled overage before future upload.
LANGSMITH_FREE_TIER_CONFIRMED=false
# LANGSMITH_TRACING is intentionally not used. Cloud export needs explicit CLI approval.

# Default: deterministic fixture embeddings. Fill these values without enabling calls.
# Future real memory needs AGENT_MEMORY_MODE=qwen AND --allow-memory-model-calls.
# Agent chat and LangSmith still require their own independent authorization.
AGENT_MEMORY_MODE=offline
MEMORY_LLM_MODEL=qwen3.8-flash
MEMORY_EMBEDDING_MODEL=text-embedding-v4
MEMORY_EMBEDDING_DIMENSIONS=1024
# Provisional Mem0 score threshold; real semantic quality has NOT been validated.
MEMORY_RECALL_THRESHOLD=0.55
# Reuses DASHSCOPE_API_KEY and QWEN_BASE_URL. No Mem0 Cloud/OpenAI key needed.
# Beijing chat input/output CNY0.8/2.7 per M; embedding input CNY0.5 per M.
MEMORY_PRICING_CONFIRMED=false
# Enforced before loading the Mem0 SDK; never enables telemetry from ambient env.
MEM0_TELEMETRY=false
# Force mock/offline even if existing .env.local selects qwen/cloud:
# npm run start:offline
