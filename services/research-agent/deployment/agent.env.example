# Install privately as /etc/research-agent/agent.env (root:root, 0600).
# Initially validate the server without paid calls or cloud uploads.
AGENT_MODE=mock
AGENT_TRACE_MODE=offline
AGENT_MEMORY_MODE=offline
AGENT_TOOLS_MODE=mock
AGENT_PORT=4322
AGENT_PUBLIC_ORIGIN=https://comments.leonzk.cn
AGENT_DATA_DIR=/var/lib/research-agent
AGENT_TRIAL_BUDGET_YUAN=5
AGENT_VALIDATION_BUDGET_YUAN=0.5
AGENT_WEB_VALIDATION_BUDGET_YUAN=0.3
TAVILY_API_KEY=
TAVILY_PRICING_CONFIRMED=false
TAVILY_FREE_TIER_CONFIRMED=false
# Must match/preserve the original ledger at migration time, never reset to zero.
# Placeholder only: refresh from the live ledger before deployment.
AGENT_TRIAL_SEED_RESERVED_UNITS=6724
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-flash
QWEN_PRICING_CONFIRMED=false
MEMORY_LLM_MODEL=qwen3.8-flash
MEMORY_EMBEDDING_MODEL=text-embedding-v4
MEMORY_EMBEDDING_DIMENSIONS=1024
MEMORY_RECALL_THRESHOLD=0.55
MEMORY_PRICING_CONFIRMED=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=private-research-agent-dev
LANGSMITH_WORKSPACE_ID=
LANGSMITH_FREE_TIER_CONFIRMED=false
