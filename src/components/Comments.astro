---
import 'artalk/Artalk.css';

interface Props {
  prompt: string;
}

const { prompt } = Astro.props;
---

<section id="comments" class="comments-section" data-comments data-prompt={prompt}>
  <h2 class="comments-title">💬 评论</h2>
  <p class="comments-prompt">{prompt}</p>
  <div class="comments-status" role="status" aria-live="polite">正在连接评论服务，首次访问可能需要几秒…</div>
  <button class="comments-retry" type="button" hidden>重新检查</button>
  <div class="artalk-wrap" hidden></div>
</section>

<script>
  import Artalk from 'artalk';

  const serverURL = 'https://comments.leonzk.cn';

  document.querySelectorAll<HTMLElement>('[data-comments]').forEach((section) => {
    const status = section.querySelector<HTMLElement>('.comments-status');
    const retry = section.querySelector<HTMLButtonElement>('.comments-retry');
    const container = section.querySelector<HTMLElement>('.artalk-wrap');
    const prompt = section.dataset.prompt || '欢迎留下你的问题或建议。';
    let artalk: Artalk | undefined;

    const showUnavailable = (message: string) => {
      if (status) {
        status.hidden = false;
        status.textContent = message;
      }
      if (retry) retry.hidden = false;
      if (container) container.hidden = true;
    };

    const checkAndInit = async () => {
      if (retry) retry.hidden = true;
      if (status) status.textContent = '正在连接评论服务，首次访问可能需要几秒…';

      const controller = new AbortController();
      const timer = window.setTimeout(() => controller.abort(), 12000);
      try {
        const url = new URL('/api/v2/conf', serverURL);
        const response = await fetch(url, { signal: controller.signal });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const payload = await response.json();
        if (payload.version?.app !== 'artalk' || !payload.frontend_conf) {
          throw new Error('Invalid comment response');
        }

        if (status) status.hidden = true;
        if (container) container.hidden = false;
        if (!artalk && container) {
          artalk = Artalk.init({
            el: container,
            server: serverURL,
            site: '张坤个人主页',
            pageKey: location.pathname,
            pageTitle: document.title,
            locale: 'zh-CN',
            darkMode: document.documentElement.classList.contains('dark'),
            reqTimeout: 12000,
            emoticons: false,
            imgUpload: false,
            versionCheck: false,
            preferRemoteConf: false,
            placeholder: `${prompt}\n评论将先进入审核，请勿发布广告或敏感信息。`,
          });
        }
      } catch (error) {
        const detail = error instanceof DOMException && error.name === 'AbortError'
          ? '连接超时'
          : '后端暂不可用';
        showUnavailable(`评论维护中（${detail}），目前无法提交。你可以稍后重试。`);
      } finally {
        window.clearTimeout(timer);
      }
    };

    retry?.addEventListener('click', checkAndInit);
    window.addEventListener('themechange', () => {
      artalk?.setDarkMode(document.documentElement.classList.contains('dark'));
    });
    void checkAndInit();
  });
</script>
