---
/** Bazi study room 2.0 — deterministic local calculation, no network persistence. */
import { CITIES } from '../../data/jing/cities';
---

<form id="bazi-form" class="jing-bazi" autocomplete="off" novalidate>
  <header class="bazi-form-head">
    <div><p class="jing-eyebrow">本地排盘 · 输入不会上传</p><h2>立一卷可复核的四柱</h2></div>
    <label class="bazi-case-label">案卷名（可空）<input id="bazi-label" type="text" maxlength="24" placeholder="例如：旧案复核" /></label>
  </header>
  <fieldset class="jing-fieldset">
    <legend>一 · 选择输入方式</legend>
    <div class="bazi-segments" role="radiogroup" aria-label="历法输入方式">
      <label><input type="radio" name="inputMode" value="solar" checked /><span>公历</span></label>
      <label><input type="radio" name="inputMode" value="lunar" /><span>农历</span></label>
      <label><input type="radio" name="inputMode" value="pillars" /><span>已知四柱</span></label>
    </div>
    <div id="bazi-solar-fields" class="bazi-input-panel">
      <div class="jing-bazi-grid">
        <label>年<input id="bazi-year" type="number" min="1900" max="2100" step="1" placeholder="年" /></label>
        <label>月<input id="bazi-month" type="number" min="1" max="12" step="1" placeholder="月" /></label>
        <label>日<input id="bazi-day" type="number" min="1" max="31" step="1" placeholder="日" /></label>
        <label>时<input id="bazi-hour" type="number" min="0" max="23" step="1" placeholder="时" /></label>
        <label>分<input id="bazi-minute" type="number" min="0" max="59" step="1" placeholder="分" /></label>
      </div><p class="jing-bazi-hint">支持 1900—2100 年；精确时刻未知时可勾选下方“分钟未知”。</p>
    </div>
    <div id="bazi-lunar-fields" class="bazi-input-panel" hidden>
      <div class="jing-bazi-grid">
        <label>农历年<input id="bazi-lunar-year" type="number" min="1900" max="2100" step="1" /></label>
        <label>月<input id="bazi-lunar-month" type="number" min="1" max="12" step="1" /></label>
        <label>日<input id="bazi-lunar-day" type="number" min="1" max="30" step="1" /></label>
        <label>时<input id="bazi-lunar-hour" type="number" min="0" max="23" step="1" /></label>
        <label>分<input id="bazi-lunar-minute" type="number" min="0" max="59" step="1" /></label>
      </div><label class="bazi-check"><input id="bazi-leap-month" type="checkbox" /> 此月为闰月（若该年无此闰月会明确报错）</label>
    </div>
    <div id="bazi-pillar-fields" class="bazi-input-panel" hidden>
      <div class="jing-bazi-grid bazi-pillar-inputs">
        <label>年柱<input id="bazi-year-pillar" maxlength="2" placeholder="如 丙寅" /></label>
        <label>月柱<input id="bazi-month-pillar" maxlength="2" placeholder="如 癸巳" /></label>
        <label>日柱<input id="bazi-day-pillar" maxlength="2" placeholder="如 癸酉" /></label>
        <label>时柱<input id="bazi-hour-pillar" maxlength="2" placeholder="如 壬子" /></label>
      </div><p class="jing-bazi-hint">只接受六十甲子中的有效组合。已知四柱没有出生时刻，故不生成起运、大运和流年。</p>
    </div>
  </fieldset>
  <fieldset id="bazi-profile-rules" class="jing-fieldset">
    <legend>二 · 起运依据</legend>
    <div class="jing-bazi-radios" role="radiogroup" aria-label="性别">
      <span class="jing-bazi-radio-title">性别（用于顺逆排）：</span>
      <label><input type="radio" name="gender" value="male" checked /> 男</label>
      <label><input type="radio" name="gender" value="female" /> 女</label>
      <label class="bazi-check"><input id="bazi-unknown-minute" type="checkbox" /> 分钟未知，以 00 分暂排</label>
    </div>
  </fieldset>
  <details id="bazi-calibration" class="bazi-calibration">
    <summary>三 · 校准设置 <small>法定时 / 真太阳时 / 晚子时 / 起运法</small></summary>
    <div class="bazi-calibration-body">
      <div class="jing-bazi-radios" role="radiogroup" aria-label="时刻制度">
        <label><input type="radio" name="timeMode" value="legal" checked /> 法定时（北京时间）</label>
        <label><input type="radio" name="timeMode" value="true-solar" /> 真太阳时（按经度修正）</label>
      </div>
      <div class="jing-bazi-place" id="bazi-place" hidden>
        <label>城市<select id="bazi-city">{CITIES.map((city) => <option value={city.longitude}>{city.name}（{city.longitude}°E）</option>)}<option value="manual">手动输入经度</option></select></label>
        <label>东经（度）<input id="bazi-longitude" type="number" min="70" max="140" step="0.01" value={CITIES[0].longitude} /></label>
      </div>
      <p id="bazi-time-preview" class="bazi-time-preview">法定时不作经度校正。</p>
      <div class="jing-bazi-radios" role="radiogroup" aria-label="晚子时规则"><span class="jing-bazi-radio-title">晚子时：</span><label><input type="radio" name="lateZi" value="next-day" checked /> 23 点换日</label><label><input type="radio" name="lateZi" value="same-day" /> 0 点换日</label></div>
      <div class="jing-bazi-radios" role="radiogroup" aria-label="起运算法"><span class="jing-bazi-radio-title">起运法：</span><label><input type="radio" name="luckSect" value="2" checked /> 分钟折算（推荐）</label><label><input type="radio" name="luckSect" value="1" /> 时辰折算（传统）</label></div>
    </div>
  </details>
  <div class="jing-bazi-actions"><button type="submit" id="bazi-submit" class="jing-btn jing-btn-primary">排盘</button><button type="button" id="bazi-now" class="jing-btn">填入此刻</button><button type="reset" class="jing-btn">清空</button><span id="bazi-status" class="jing-calc-status" role="status" aria-live="polite">选择输入方式后排盘</span></div>
  <p id="bazi-error" class="jing-bazi-error" role="alert" hidden></p>
</form>

<section id="bazi-result" class="jing-bazi-result" hidden aria-live="polite" tabindex="-1">
  <header class="jing-study-result-head"><div><p class="jing-eyebrow">本地推演 · bazi-2.0.0</p><h2 class="jing-calc-result-title">八字排盘结果</h2></div><div class="jing-study-result-tools"><button type="button" id="bazi-edit" class="jing-btn">修改输入</button></div></header>
  <nav class="bazi-view-tabs" aria-label="盘面层级"><button type="button" data-bazi-view="basic" class="is-active" aria-pressed="true">基础盘</button><button type="button" data-bazi-view="pro" aria-pressed="false">专业盘</button></nav>
  <details id="bazi-sec-summary" open><summary>输入摘要</summary><p id="bazi-summary-text"></p><p class="bazi-privacy-note">隐私分享会自动移除出生日期、地点与案卷名，只保留盘面结构。</p><div class="bazi-result-actions"><button type="button" id="bazi-copy" class="jing-btn">复制隐私摘要</button><button type="button" id="bazi-share-image" class="jing-btn">保存隐私分享图</button><button type="button" id="bazi-save-case" class="jing-btn">存入手札案卷</button><button type="button" class="jing-term-chip" data-jing-term="four-pillars">问典：四柱</button></div><span id="bazi-copy-state" class="jing-bazi-copy-state" role="status"></span></details>
  <details id="bazi-sec-pillars" open><summary>盘面</summary><div id="bazi-pillars" class="jing-bazi-pillars"></div><p id="bazi-elements" class="jing-bazi-elements"></p><div id="bazi-element-bars" class="jing-bazi-element-bars" aria-label="五行分布比例"></div><section id="bazi-interpret" class="jing-bazi-interpret"></section><section class="bazi-pro-only" hidden><h3>专业层说明</h3><p>藏干、纳音与旬空按固定表逐柱列出；神煞因流派表差异较大，本版不作自动吉凶判定。</p></section></details>
  <details id="bazi-sec-luck" class="bazi-pro-only" hidden open>
    <summary>岁运与干支关系</summary>
    <section id="bazi-luck-wrap">
      <header class="bazi-section-head">
        <div><h3>大运</h3><p id="bazi-luck-meta"></p></div>
        <button id="bazi-luck-current" type="button" class="jing-btn">定位当下</button>
      </header>
      <div id="bazi-dayun-timeline" class="bazi-timeline" role="group" aria-label="大运时间轴"></div>
      <h3>流年</h3>
      <div id="bazi-liunian-timeline" class="bazi-timeline bazi-liunian" role="group" aria-label="流年时间轴"></div>
      <details class="bazi-month-panel">
        <summary>展开流月</summary>
        <p class="jing-bazi-hint">按十二节换月；正月至十二月为节令月标记，与农历月初不重合。</p>
        <div id="bazi-liuyue-timeline" class="bazi-timeline bazi-liunian" role="group" aria-label="流月时间轴"></div>
      </details>
    </section>
    <p id="bazi-luck-empty" class="bazi-empty" hidden>已知四柱模式缺少出生日期，因此无法计算起运时点。可继续查看本命干支关系。</p>
    <section class="bazi-relation-panel">
      <header class="bazi-section-head">
        <div><h3>干支关系图</h3><p>点击柱位或关系可高亮对应连线；绿为合会、赭为冲刑害破。</p></div>
        <button id="bazi-ask-current" type="button" class="jing-btn">问典：当前结构</button>
      </header>
      <div id="bazi-relation-nodes" class="bazi-relation-nodes"></div>
      <svg id="bazi-relation-svg" class="bazi-relation-svg" viewBox="0 0 650 290" role="img" aria-label="干支关系连线图"></svg>
      <ul id="bazi-relations" class="bazi-relation-list"></ul>
    </section>
  </details>
  <details id="bazi-sec-derivation" class="bazi-pro-only" hidden><summary>推演依据</summary><ol id="bazi-derivation" class="jing-bazi-derivation"></ol></details>
  <details id="bazi-sec-reminders" open><summary>边界与提醒</summary><ul id="bazi-reminders" class="jing-bazi-reminders"></ul></details>
</section>

<script>
  import "../../lib/jing/bazi/controller";
</script>

<style is:global>
.jing-route-bazi .jing-bazi {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}
.jing-route-bazi .bazi-form-head,
.jing-route-bazi .jing-study-result-head,
.jing-route-bazi .bazi-section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
}
.jing-route-bazi .bazi-form-head h2,
.jing-route-bazi .bazi-section-head h3 {
  margin: 0;
  font-weight: 500;
  color: var(--jing-accent);
}
.jing-route-bazi .bazi-case-label {
  width: min(17rem, 40%);
  font: 0.72rem var(--jing-font-ui);
  color: var(--jing-text-dim);
}
.jing-route-bazi .jing-fieldset,
.jing-route-bazi .bazi-calibration {
  border: 1px solid var(--jing-border);
  border-radius: var(--jing-radius);
  padding: 1rem 1.1rem 1.2rem;
  background: var(--jing-bg-raised);
}
.jing-route-bazi .jing-fieldset legend {
  padding: 0 0.5em;
  color: var(--jing-text-dim);
  letter-spacing: 0.2em;
  font-size: 0.82rem;
}
.jing-route-bazi .bazi-segments,
.jing-route-bazi .bazi-view-tabs {
  display: inline-flex;
  gap: 0.25rem;
  padding: 0.2rem;
  border: 1px solid var(--jing-border);
  background: #08060459;
}
.jing-route-bazi .bazi-segments input {
  position: static;
  opacity: 1;
}
.jing-route-bazi .bazi-segments span,
.jing-route-bazi .bazi-view-tabs button {
  display: block;
  min-width: 5rem;
  padding: 0.5rem 0.9rem;
  border: 0;
  color: var(--jing-text-dim);
  background: transparent;
  text-align: center;
  cursor: pointer;
}
.jing-route-bazi .bazi-segments input:checked + span,
.jing-route-bazi .bazi-segments input:focus-visible + span,
.jing-route-bazi .bazi-view-tabs button.is-active {
  color: #f0d59e;
  background: linear-gradient(#97642473, #5b38124d);
  outline: 1px solid #c4914180;
}
.jing-route-bazi .bazi-input-panel {
  margin-top: 1rem;
}
.jing-route-bazi .bazi-input-panel[hidden],
.jing-route-bazi .jing-bazi-place[hidden],
.jing-route-bazi .jing-bazi-result[hidden],
.jing-route-bazi .bazi-pro-only[hidden] {
  display: none !important;
}
.jing-route-bazi .jing-bazi-grid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 0.65rem;
}
.jing-route-bazi .bazi-pillar-inputs {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}
.jing-route-bazi .jing-bazi label,
.jing-route-bazi .bazi-case-label {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}
.jing-route-bazi .jing-bazi input,
.jing-route-bazi .jing-bazi select {
  width: 100%;
  box-sizing: border-box;
  border: 1px solid var(--jing-border);
  border-radius: 5px;
  padding: 0.52rem 0.55rem;
  color: var(--jing-text);
  background: var(--jing-bg-card);
  font: 0.9rem var(--jing-font-ui);
}
.jing-route-bazi .jing-bazi input:focus-visible,
.jing-route-bazi .jing-bazi select:focus-visible,
.jing-route-bazi .bazi-view-tabs button:focus-visible {
  outline: 2px solid var(--jing-accent);
  outline-offset: 2px;
}
.jing-route-bazi .bazi-segments { flex-wrap: wrap; }
.jing-route-bazi .bazi-segments label { flex-direction: row; align-items: center; gap: 0; }
.jing-route-bazi .bazi-segments input { width: 14px; height: 14px; padding: 0; margin: 0 0 0 .4rem; accent-color: #b18a45; }
.jing-route-bazi .bazi-segments span { min-width: 3.8rem; padding: .5rem .45rem; }
.jing-route-bazi .jing-bazi-hint,
.jing-route-bazi .bazi-time-preview,
.jing-route-bazi .bazi-privacy-note,
.jing-route-bazi .bazi-section-head p,
.jing-route-bazi .bazi-empty {
  margin: 0.65rem 0 0;
  color: var(--jing-text-dim);
  font: 0.72rem/1.7 var(--jing-font-ui);
}
.jing-route-bazi .bazi-check {
  flex-direction: row !important;
  align-items: center;
  margin-top: 0.75rem;
  font: 0.78rem var(--jing-font-ui);
}
.jing-route-bazi .bazi-check input {
  width: auto;
}
.jing-route-bazi .jing-bazi-radios {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.65rem 1.2rem;
  font: 0.8rem var(--jing-font-ui);
}
.jing-route-bazi .jing-bazi-radios label {
  flex-direction: row;
  align-items: center;
}
.jing-route-bazi .jing-bazi-radios input {
  width: auto;
}
.jing-route-bazi .jing-bazi-radio-title {
  color: var(--jing-text-dim);
}
.jing-route-bazi .bazi-calibration {
  padding: 0;
}
.jing-route-bazi .bazi-calibration summary {
  cursor: pointer;
  padding: 0.9rem 1rem;
  color: var(--jing-accent);
  letter-spacing: 0.12em;
}
.jing-route-bazi .bazi-calibration summary small {
  margin-left: 0.7rem;
  color: var(--jing-text-dim);
  letter-spacing: 0;
}
.jing-route-bazi .bazi-calibration-body {
  display: grid;
  gap: 0.9rem;
  padding: 0 1rem 1rem;
}
.jing-route-bazi .jing-bazi-place {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.6rem;
}
.jing-route-bazi .jing-bazi-actions,
.jing-route-bazi .bazi-result-actions,
.jing-route-bazi .jing-study-result-tools {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.6rem;
}
.jing-route-bazi .jing-calc-status {
  color: var(--jing-accent);
  font: 0.72rem var(--jing-font-ui);
}
.jing-route-bazi .jing-calc-status.is-error,
.jing-route-bazi .jing-bazi-error {
  color: var(--jing-vermilion);
}
.jing-route-bazi .jing-bazi-error {
  margin: 0;
  padding: 0.7rem 0.9rem;
  border: 1px solid var(--jing-vermilion);
  border-radius: 6px;
  font: 0.84rem var(--jing-font-ui);
}
.jing-route-bazi .jing-bazi-result {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  margin-top: 1.5rem;
}
.jing-route-bazi .jing-calc-result-title {
  margin: 0;
  color: var(--jing-accent);
  font-size: 1.1rem;
  font-weight: 500;
  letter-spacing: 0.16em;
}
.jing-route-bazi .jing-bazi-result > details {
  border: 1px solid var(--jing-border);
  border-radius: var(--jing-radius);
  padding: 0.6rem 1rem 0.9rem;
  background: var(--jing-bg-raised);
}
.jing-route-bazi .jing-bazi-result > details > summary {
  cursor: pointer;
  padding: 0.4rem 0;
  color: var(--jing-accent);
  letter-spacing: 0.2em;
}
.jing-route-bazi .bazi-view-tabs {
  align-self: flex-start;
}
.jing-route-bazi .jing-bazi-pillars {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 0.6rem;
  margin: 0.7rem 0;
}
.jing-route-bazi .jing-bazi-pillar {
  border: 1px solid var(--jing-border);
  border-radius: 8px;
  padding: 0.75rem 0.55rem;
  background: var(--jing-bg-card);
  animation: bazi-rise 0.5s ease both;
}
.jing-route-bazi .jing-bazi-pillar header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: var(--jing-text-dim);
  font-size: 0.7rem;
}
.jing-route-bazi .jing-bazi-pillar header button {
  border: 0;
  border-bottom: 1px dotted var(--jing-accent);
  color: var(--jing-accent);
  background: transparent;
  cursor: pointer;
}
.jing-route-bazi .jing-bazi-ganzhi {
  display: grid;
  place-items: center;
  gap: 0.15rem;
  padding: 0.55rem 0;
}
.jing-route-bazi .jing-bazi-ganzhi strong {
  color: var(--jing-text);
  font-size: 1.65rem;
  letter-spacing: 0.12em;
}
.jing-route-bazi .jing-bazi-pillar dl {
  display: grid;
  gap: 0.35rem;
  margin: 0;
}
.jing-route-bazi .jing-bazi-result[data-view="basic"] .jing-bazi-pillar dl {
  display: none;
}
.jing-route-bazi .jing-bazi-pillar dl div {
  display: grid;
  grid-template-columns: 2.3rem 1fr;
  gap: 0.3rem;
}
.jing-route-bazi .jing-bazi-pillar dt {
  color: var(--jing-text-dim);
  font: 0.62rem var(--jing-font-ui);
}
.jing-route-bazi .jing-bazi-pillar dd {
  margin: 0;
  font-size: 0.72rem;
}
.jing-route-bazi .jing-bazi-pillar dd span {
  margin-right: 0.35rem;
  white-space: nowrap;
}
.jing-route-bazi .jing-bazi-pillar dd small {
  margin-left: 0.1rem;
  color: var(--jing-text-dim);
}
.jing-route-bazi .jing-bazi-element-bars {
  display: grid;
  gap: 0.4rem;
  max-width: 42rem;
}
.jing-route-bazi .jing-bazi-element-bar {
  display: grid;
  grid-template-columns: 1.5rem 1fr 1.2rem;
  gap: 0.5rem;
  align-items: center;
  font-size: 0.75rem;
}
.jing-route-bazi .jing-bazi-element-bar i {
  height: 5px;
  overflow: hidden;
  background: #fff1;
}
.jing-route-bazi .jing-bazi-element-bar b {
  display: block;
  width: var(--bar-size);
  height: 100%;
  background: linear-gradient(90deg, #82551e, #d0a04e);
  animation: bazi-bar 0.7s ease var(--bar-delay) both;
}
.jing-route-bazi .jing-bazi-element-bar em {
  color: var(--jing-text-dim);
  font-style: normal;
}
.jing-route-bazi .jing-bazi-interpret {
  margin-top: 1rem;
  padding-top: 0.65rem;
  border-top: 1px solid var(--jing-border);
}
.jing-route-bazi .jing-bazi-interpret p,
.jing-route-bazi .jing-bazi-elements {
  margin: 0.45rem 0;
  line-height: 1.8;
}
.jing-route-bazi .bazi-section-head h3 {
  font-size: 0.95rem;
}
.jing-route-bazi .bazi-timeline {
  display: flex;
  gap: 0.45rem;
  overflow-x: auto;
  padding: 0.6rem 0.1rem 1rem;
  scroll-snap-type: x proximity;
}
.jing-route-bazi .bazi-timeline button {
  flex: 0 0 7.2rem;
  display: grid;
  gap: 0.25rem;
  scroll-snap-align: start;
