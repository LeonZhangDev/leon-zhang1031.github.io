---
/**
 * LocalNotebook — encrypted private notes.
 *
 * All crypto and storage go through src/lib/jing/vault.ts; this component
 * only wires DOM events. Plaintext exists solely in the textarea and the
 * in-memory session; the idle auto-lock wipes it.
 */
---

<div class="jing-notes" id="jing-notes-app">
  <p class="jing-notes-status" id="notes-status" role="status" aria-live="polite"></p>

  <section id="notes-create" class="jing-notes-view" hidden>
    <h2>创建加密笔记</h2>
    <p>第一次使用需要设置密码。密码只存在你的记忆里——忘记密码将无法恢复笔记。</p>
    <p class="jing-field">
      <label for="notes-new-password">密码（至少 4 位）</label>
      <input type="password" id="notes-new-password" autocomplete="new-password" minlength="4" />
    </p>
    <p class="jing-field">
      <label for="notes-new-password2">再输一次</label>
      <input type="password" id="notes-new-password2" autocomplete="new-password" minlength="4" />
    </p>
    <button type="button" id="notes-create-btn" class="jing-btn">创建并解锁</button>
  </section>

  <section id="notes-unlock" class="jing-notes-view" hidden>
    <h2>解锁笔记</h2>
    <p class="jing-field">
      <label for="notes-password">密码</label>
      <input type="password" id="notes-password" autocomplete="current-password" />
    </p>
    <button type="button" id="notes-unlock-btn" class="jing-btn">解锁</button>
  </section>

  <section id="notes-editor" class="jing-notes-view" hidden>
    <p class="jing-field">
      <label for="notes-text">笔记内容（保存时加密，仅本机存储）</label>
      <textarea id="notes-text" rows="12" spellcheck="false"></textarea>
    </p>
    <section class="jing-casebook" id="notes-casebook" aria-labelledby="notes-casebook-title">
      <header><div><p class="jing-eyebrow">从排盘与签录显式存入</p><h3 id="notes-casebook-title">研习案卷</h3></div><div class="jing-casebook-tools"><label for="notes-case-filter">筛选</label><select id="notes-case-filter"><option value="all">全部</option><option value="bazi">八字</option><option value="qimen">奇门</option><option value="yijing">周易</option><option value="lot">签录</option></select><span id="notes-case-count">0 卷</span></div></header>
      <p id="notes-case-empty">尚无案卷。完成八字、奇门、周易或抽签后，可选择“存入手札案卷”。</p>
      <ol id="notes-case-list"></ol>
      <section id="notes-case-compare" class="jing-case-compare" hidden aria-live="polite"></section>
    </section>
    <div class="jing-notes-actions">
      <button type="button" id="notes-save-btn" class="jing-btn">保存（加密）</button>
      <button type="button" id="notes-lock-btn" class="jing-btn">立即锁定</button>
      <button type="button" id="notes-export-btn" class="jing-btn">导出 .jing</button>
      <label class="jing-btn jing-btn-file" for="notes-import-input">
        导入 .jing
        <input type="file" id="notes-import-input" accept=".jing,application/json" hidden />
      </label>
      <button type="button" id="notes-clear-btn" class="jing-btn jing-btn-danger">清空全部</button>
    </div>
    <p class="jing-field jing-field-inline">
      <label for="notes-lock-minutes">自动锁定（分钟，下次解锁生效）</label>
      <input type="number" id="notes-lock-minutes" min="1" max="120" />
    </p>
  </section>

  <section id="notes-import-auth" class="jing-notes-view" hidden>
    <h2>验证导入文件</h2>
    <p>导入前需要用该文件原来的密码验证，验证失败不会覆盖现有笔记。</p>
    <p class="jing-field">
      <label for="notes-import-password">文件密码</label>
      <input type="password" id="notes-import-password" autocomplete="off" />
    </p>
    <div class="jing-notes-actions">
      <button type="button" id="notes-import-confirm" class="jing-btn">验证并导入</button>
      <button type="button" id="notes-import-cancel" class="jing-btn">取消</button>
    </div>
  </section>
</div>

<script>
  import {
    VaultError,
    VaultSession,
    hasStoredVault,
  } from '../../lib/jing/vault';
  import { loadSettings, saveSettings } from '../../lib/jing/settings';
  import { parseStudyCases, type StudyCaseRecord } from '../../lib/jing/study-case';
  import { openStudyCase } from '../../lib/jing/study-handoff';

  type ViewId = 'notes-create' | 'notes-unlock' | 'notes-editor' | 'notes-import-auth';

  const app = document.getElementById('jing-notes-app');
  if (app) {
    const status = document.getElementById('notes-status') as HTMLElement;
    const views: ViewId[] = ['notes-create', 'notes-unlock', 'notes-editor', 'notes-import-auth'];

    const text = document.getElementById('notes-text') as HTMLTextAreaElement;
    const lockMinutes = document.getElementById('notes-lock-minutes') as HTMLInputElement;

    let session: VaultSession | null = null;
    let pendingImport: string | null = null;
    let caseRecords: StudyCaseRecord[] = [];
    const caseFilter = document.getElementById('notes-case-filter') as HTMLSelectElement;
    let cancelHandoff: (() => void) | null = null;
    const wipeCasebook = () => {
      cancelHandoff?.(); cancelHandoff = null;
      caseRecords = [];
      document.getElementById('notes-case-list')?.replaceChildren();
      document.getElementById('notes-case-compare')?.replaceChildren();
      document.getElementById('notes-case-compare')!.hidden = true;
      (document.getElementById('notes-new-password') as HTMLInputElement).value = '';
      (document.getElementById('notes-new-password2') as HTMLInputElement).value = '';
      (document.getElementById('notes-password') as HTMLInputElement).value = '';
    };

    const say = (msg: string) => { status.textContent = msg; };

    const show = (id: ViewId) => {
      views.forEach((v) => {
        const el = document.getElementById(v);
        if (el) el.hidden = v !== id;
      });
    };

    const sessionOptions = () => ({
      storage: localStorage,
      lockTimeoutMs: loadSettings(localStorage).settings.lockTimeoutMinutes * 60 * 1000,
      onLock: () => {
        session = null;
        text.value = '';
        wipeCasebook();
        show('notes-unlock');
        say('已自动锁定。');
      },
    });

    const describeError = (err: unknown): string => {
      if (err instanceof VaultError) {
        switch (err.code) {
          case 'wrong-password': return '密码错误或数据已被改动。';
          case 'damaged': return err.message;
          case 'unsupported-version': return err.message;
          case 'unsupported-crypto': return err.message;
          case 'storage-denied': return err.message;
        }
      }
      return '操作失败，请重试。';
    };

    const renderCaseCompare = () => {
      const compare = document.getElementById('notes-case-compare')!;
      const selected = Array.from(document.querySelectorAll<HTMLInputElement>('#notes-case-list input:checked'))
        .map((input) => caseRecords[Number(input.dataset.caseIndex)])
        .filter(Boolean);
      if (selected.length !== 2) { compare.hidden = true; compare.replaceChildren(); return; }
      compare.hidden = false;
      compare.replaceChildren();
      const heading = document.createElement('h4');
      heading.textContent = '双案对照';
      compare.append(heading);
      const table = document.createElement('div');
      table.className = 'jing-case-compare-grid';
      for (const record of selected) {
        const article = document.createElement('article');
        const title = document.createElement('h5');
        const resultCopy = document.createElement('p');
        const rule = document.createElement('small');
        title.textContent = record.title;
        resultCopy.textContent = record.resultSummary;
        rule.textContent = `${record.ruleVersion} · ${new Date(record.createdAt).toLocaleString('zh-CN')}`;
        article.append(title, resultCopy, rule);
        table.append(article);
      }
      compare.append(table);
    };

    const renderCasebook = () => {
      caseRecords = parseStudyCases(text.value);
      const list = document.getElementById('notes-case-list')!;
      const empty = document.getElementById('notes-case-empty')!;
      const count = document.getElementById('notes-case-count')!;
      count.textContent = `${caseRecords.length} 卷`;
      empty.hidden = caseRecords.length > 0;
      list.replaceChildren();
      caseRecords.forEach((record, index) => {
        if (caseFilter.value !== 'all' && record.kind !== caseFilter.value) return;
        const item = document.createElement('li');
        const check = document.createElement('input');
        const copy = document.createElement('button');
        const actions = document.createElement('div');
        const heading = document.createElement('strong');
        const meta = document.createElement('span');
        check.type = 'checkbox';
        check.dataset.caseIndex = String(index);
        check.setAttribute('aria-label', `选择${record.title}作对照`);
        heading.textContent = record.title;
        meta.textContent = `${new Date(record.createdAt).toLocaleString('zh-CN')} · ${record.ruleVersion}`;
        copy.type = 'button';
        copy.className = 'jing-btn';
        copy.dataset.copyCase = String(index);
        copy.textContent = '复制无隐私摘要';
        actions.className = 'jing-case-actions';
        actions.append(copy);
        if (record.resume?.route === '/jing/bazi/') {
          const resume = document.createElement('button');
          resume.type = 'button'; resume.className = 'jing-btn'; resume.dataset.resumeCase = String(index);
          resume.textContent = '继续研习（新页）'; actions.prepend(resume);
        }
        item.append(check, heading, meta, actions);
        list.append(item);
      });
      renderCaseCompare();
    };

    const openEditor = () => {
      if (!session) return;
      text.value = session.getNotes();
      lockMinutes.value = String(loadSettings(localStorage).settings.lockTimeoutMinutes);
      show('notes-editor');
      renderCasebook();
    };

    /* initial view */
    if (hasStoredVault(localStorage)) {
      show('notes-unlock');
      say('检测到本机已有加密笔记，请输入密码解锁。');
    } else {
      show('notes-create');
      say('本机还没有加密笔记。');
    }

    /* create */
    document.getElementById('notes-create-btn')?.addEventListener('click', async () => {
      const p1 = (document.getElementById('notes-new-password') as HTMLInputElement).value;
      const p2 = (document.getElementById('notes-new-password2') as HTMLInputElement).value;
      if (p1.length < 4) { say('密码至少 4 位。'); return; }
      if (p1 !== p2) { say('两次输入的密码不一致。'); return; }
      try {
        session = await VaultSession.create(p1, sessionOptions());
        say('已创建并解锁。');
        openEditor();
      } catch (err) {
        say(describeError(err));
      }
    });

    /* unlock */
    document.getElementById('notes-unlock-btn')?.addEventListener('click', async () => {
      const pw = (document.getElementById('notes-password') as HTMLInputElement).value;
      try {
        session = await VaultSession.unlock(pw, sessionOptions());
        say('已解锁。');
        openEditor();
      } catch (err) {
        say(describeError(err));
      }
    });
    document.getElementById('notes-password')?.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Enter') {
        document.getElementById('notes-unlock-btn')?.click();
      }
    });

    /* save / lock / export / clear */
    document.getElementById('notes-save-btn')?.addEventListener('click', async () => {
      if (!session) { say('笔记已锁定，请先解锁。'); return; }
      try {
        await session.saveNotes(text.value);
        renderCasebook();
        say('已保存（加密存储于本机）。');
      } catch (err) {
        say(describeError(err));
      }
    });

    document.getElementById('notes-lock-btn')?.addEventListener('click', () => {
      session?.lock();
      session = null;
      text.value = '';
      show('notes-unlock');
      say('已锁定。');
    });

    document.getElementById('notes-export-btn')?.addEventListener('click', () => {
      if (!session) { say('笔记已锁定，请先解锁。'); return; }
      const file = session.exportFile();
      if (!file) { say('没有可导出的笔记。'); return; }
      const blob = new Blob([file], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `jing-notes-${new Date().toISOString().slice(0, 10)}.jing`;
      a.click();
      URL.revokeObjectURL(url);
      say('已导出加密文件。');
    });

    document.getElementById('notes-clear-btn')?.addEventListener('click', () => {
      if (!window.confirm('确定清空本机全部加密笔记？此操作不可恢复。')) return;
      session?.clearAll();
      session = null;
      text.value = '';
      wipeCasebook();
      show('notes-create');
      say('已清空。');
    });

    /* import: read file -> ask password -> validate -> apply */
    document.getElementById('notes-import-input')?.addEventListener('change', async (e) => {
      const input = e.target as HTMLInputElement;
      const file = input.files?.[0];
      input.value = '';
      if (!file) return;
      pendingImport = await file.text();
      show('notes-import-auth');
      say('请输入导入文件原来的密码。');
    });

    document.getElementById('notes-import-confirm')?.addEventListener('click', async () => {
      if (pendingImport === null) return;
      const pw = (document.getElementById('notes-import-password') as HTMLInputElement).value;
      try {
        session = await VaultSession.importFrom(pw, pendingImport, sessionOptions());
        pendingImport = null;
        say('导入成功。');
        openEditor();
      } catch (err) {
        say(describeError(err));
      }
    });

    document.getElementById('notes-import-cancel')?.addEventListener('click', () => {
      pendingImport = null;
      show(hasStoredVault(localStorage) ? 'notes-unlock' : 'notes-create');
      say('已取消导入，现有笔记未改动。');
    });

    /* lock timeout preference */
    lockMinutes.addEventListener('change', () => {
      const current = loadSettings(localStorage);
      saveSettings(localStorage, {
        ...current.settings,
        lockTimeoutMinutes: Number(lockMinutes.value),
      });
      say('自动锁定时间已更新，下次解锁时生效。');
    });

    document.getElementById('notes-case-list')?.addEventListener('change', (event) => {
      const input = event.target as HTMLInputElement;
      if (!input.matches('input[type="checkbox"]')) return;
      const checked = Array.from(document.querySelectorAll<HTMLInputElement>('#notes-case-list input:checked'));
      if (checked.length > 2) {
        input.checked = false;
        say('双案对照一次最多选择两卷。');
      }
      renderCaseCompare();
    });
    document.getElementById('notes-case-list')?.addEventListener('click', async (event) => {
      const resume = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-resume-case]');
      if (resume) {
        const record = caseRecords[Number(resume.dataset.resumeCase)];
        if (record?.resume?.route === '/jing/bazi/') {
          cancelHandoff?.();
          cancelHandoff = openStudyCase(record, () => { session?.lock(); say('案卷已在新页恢复，手札已锁定。'); }, say);
        }
        return;
      }
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-copy-case]');
      if (!button) return;
      const record = caseRecords[Number(button.dataset.copyCase)];
      if (!record) return;
      const kindLabel = { bazi: '八字', qimen: '奇门', yijing: '周易', lot: '签录' }[record.kind];
      const safeSummary = `${kindLabel}研习\n${record.resultSummary}\n规则：${record.ruleVersion}\n—— 静心堂 · 本地研习，不含案卷名与输入摘要`;
      try {
        await navigator.clipboard.writeText(safeSummary);
        say('已复制不含出生时刻与所问事项的案卷摘要。');
      } catch {
        say('复制失败，请手动选择案卷摘要。');
      }
    });
    caseFilter.addEventListener('change', renderCasebook);

    /* any interaction counts as activity */
    app.addEventListener('input', () => session?.touch());
    app.addEventListener('click', () => session?.touch());
  }
</script>
