---
import BaseLayout from '../../layouts/BaseLayout.astro';
import 'katex/dist/katex.min.css';
import katexMainFont from 'katex/dist/fonts/KaTeX_Main-Regular.woff2?url';
import katexMathFont from 'katex/dist/fonts/KaTeX_Math-Italic.woff2?url';
import katexAmsFont from 'katex/dist/fonts/KaTeX_AMS-Regular.woff2?url';
import Comments from '../../components/Comments.astro';
import ArticleTools from '../../components/ArticleTools.astro';
import AgentLearningSidebar from '../../components/AgentLearningSidebar.astro';
import ArticleSectionSidebar from '../../components/ArticleSectionSidebar.astro';
import { getAgentCourse } from '../../data/agent-course-navigation';
import { learningPaths, readingMinutes } from '../../data/learning-paths';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
// Inspect generated math markup, including old posts whose math flag is false.
const renderedHtml = post.rendered?.html || '';
const mathFonts = renderedHtml.includes('class="katex"') ? [
  katexMainFont,
  ...(renderedHtml.includes('mathnormal') ? [katexMathFont] : []),
  ...(/class="[^"]*\b(?:amsrm|mathbb|textbb)\b/.test(renderedHtml) ? [katexAmsFont] : []),
] : [];
const toc = headings.filter(heading => heading.depth <= 3);

const allPosts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const currentIndex = allPosts.findIndex((p) => p.id === post.id);
const prevPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;
const nextPost = currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;
const series = learningPaths.find(path => path.slugs.includes(post.id));
const lessons = series?.slugs.map(slug => allPosts.find(item => item.id === slug)).filter(Boolean) || [];
const lessonIndex = lessons.findIndex(item => item?.id === post.id);
const previousLesson = lessons[lessonIndex - 1];
const nextLesson = lessons[lessonIndex + 1];
const agentCourse = getAgentCourse(allPosts);
const courseIndex = agentCourse.findIndex(item => item.id === post.id);
const isAgentCourse = courseIndex >= 0;
const coursePrevious = agentCourse[courseIndex - 1];
const courseNext = agentCourse[courseIndex + 1];
const courseToc = toc.filter(heading => heading.text !== '本章目录');
const prerequisitePosts = post.data.prerequisites.map(slug => allPosts.find(item => item.id === slug)).filter(Boolean);
const related = allPosts.filter(item => item.id !== post.id && !series?.slugs.includes(item.id))
  .map(item => ({ item, score: item.data.tags.filter(tag => post.data.tags.includes(tag)).length }))
  .filter(item => item.score > 0).sort((a,b) => b.score-a.score).slice(0,3);
const verificationLabels = { 'not-run':'示例未复跑', 'example-tested':'指定示例已运行', 'reproduced':'指定结果已复现', 'source-checked':'指定技术来源已核验' };
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <Fragment slot="head">
    {mathFonts.map(href => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin="anonymous" />)}
  </Fragment>
  <div class:list={['post-layout', { 'course-layout': isAgentCourse }]}>
  {isAgentCourse && <AgentLearningSidebar currentId={post.id} chapters={agentCourse.slice(1)} />}
  <article class:list={['post-detail container-narrow', { 'agent-learning': isAgentCourse }]}>
    <header class="post-detail-header">
      <h1 class="post-detail-title">{post.data.title}</h1>
      <div class="post-detail-meta">
        <time>{post.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric', weekday: 'long' })}</time>
        <span>·</span>
        <span>约 {readingMinutes(post.body)} 分钟</span>
        {post.data.updated && <span>更新于 {post.data.updated.toISOString().slice(0,10)}</span>}
        {post.data.tags.length > 0 && (
          <span>·
            {post.data.tags.map((tag) => <span class="post-tag-inline">#{tag}</span>)}
          </span>
        )}
      </div>
    </header>

    {(series || prerequisitePosts.length > 0 || post.data.verification) && <aside class="article-learning" aria-label="阅读指南">
      {series && <p><a href={`/posts/learning-paths/#${series.id}`}>{series.title}</a> · 第 {lessonIndex + 1} / {lessons.length} 篇</p>}
      {series?.id.startsWith('research-') && <p>科研平台是贯穿课程的教学案例；请按各课验收产物，不将案例描述视作已上线证明。</p>}
      {prerequisitePosts.length > 0 && <p>前置阅读：{prerequisitePosts.map(item => item && <a href={`/posts/${item.id}/`}>{item.data.title} </a>)}</p>}
      {post.data.verification && <p>{verificationLabels[post.data.verification.status]}：{post.data.verification.scope}</p>}
    </aside>}
    {!isAgentCourse && toc.length > 2 && <details class="article-toc">
      <summary>本文目录（{toc.length} 节）</summary>
      <nav aria-label="本文目录"><ul>{toc.map(heading => <li data-depth={heading.depth}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul></nav>
    </details>}

    <div class="prose" itemprop="articleBody">
      <Content />
    </div>

    {series && !isAgentCourse && <nav class="article-learning" aria-label="系列前后篇">
      {previousLesson && <p>上一课：<a href={`/posts/${previousLesson.id}/`}>{previousLesson.data.title}</a></p>}
      {nextLesson && <p>下一课：<a href={`/posts/${nextLesson.id}/`}>{nextLesson.data.title}</a></p>}
      <a href={`/posts/learning-paths/#${series.id}`}>查看完整路线</a>
    </nav>}
    {related.length > 0 && <aside class="article-learning" aria-label="延伸阅读"><h2>延伸阅读</h2><ul>{related.map(({ item }) => <li><a href={`/posts/${item.id}/`}>{item.data.title}</a></li>)}</ul></aside>}
    <ArticleTools />

    {isAgentCourse && <nav class="post-nav" aria-label="按学习顺序浏览">
      {coursePrevious && <a href={`/posts/${coursePrevious.id}/`} class="post-nav-link post-nav-prev" rel="prev">
        <span class="post-nav-label">← {courseIndex === 1 ? '路线总览' : '上一章'}</span>
        <span class="post-nav-title">{coursePrevious.data.title}</span>
      </a>}
      {courseNext && <a href={`/posts/${courseNext.id}/`} class="post-nav-link post-nav-next" rel="next">
        <span class="post-nav-label">{courseIndex === 0 ? '开始学习' : '下一章'} →</span>
        <span class="post-nav-title">{courseNext.data.title}</span>
      </a>}
    </nav>}
    {!isAgentCourse && (prevPost || nextPost) && (
      <nav class="post-nav" aria-label="按发布日期浏览">
        {prevPost && (
          <a href={`/posts/${prevPost.id}/`} class="post-nav-link post-nav-prev">
            <span class="post-nav-label">← 较新文章</span>
            <span class="post-nav-title">{prevPost.data.title}</span>
          </a>
        )}
        {nextPost && (
          <a href={`/posts/${nextPost.id}/`} class="post-nav-link post-nav-next">
            <span class="post-nav-label">较早文章 →</span>
            <span class="post-nav-title">{nextPost.data.title}</span>
          </a>
        )}
      </nav>
    )}

    <Comments prompt="这套方案在哪一步卡住了？也欢迎补充你的实现方式或踩坑经验。" />
  </article>
  {isAgentCourse && courseToc.length > 0 && <ArticleSectionSidebar headings={courseToc} />}
  </div>
</BaseLayout>

<style>
  .course-layout { max-width: 1480px; margin: 0 auto; padding: 0 1.5rem; display: grid; grid-template-areas: 'chapters' 'sections' 'article'; }
  .course-layout :global(.course-sidebar) { grid-area: chapters; }
  .course-layout :global(.section-sidebar) { grid-area: sections; }
  .course-layout .post-detail { grid-area: article; }
  .course-layout .post-detail { min-width: 0; width: 100%; }
  /* The generated inline index is available in the sidebar; retain it in Markdown. */
  .agent-learning :global(.prose h2[id="本章目录"]),
  .agent-learning :global(.prose h2[id="本章目录"] + ul) { display: none; }
  .agent-learning :global(.prose) { overflow-wrap: anywhere; }
  .agent-learning :global(.prose table) { display: block; max-width: 100%; overflow-x: auto; }
  .agent-learning :global(.prose pre) { overflow-wrap: normal; }
  .agent-learning :global(.prose [id]) { scroll-margin-top: 5rem; }
  @media (min-width: 1200px) {
    .course-layout { grid-template-areas: 'chapters article sections'; grid-template-columns: 230px minmax(0, 760px) 230px; gap: 2rem; justify-content: center; }
    .course-layout .post-detail { max-width: none; padding-inline: 0; }
  }
  @media (max-width: 1199px) {
    .course-layout { max-width: 760px; padding-inline: 1rem; }
    .course-layout .post-detail { padding-inline: 0; }
  }
  @media print {
    .course-layout { display: block; }
    .agent-learning :global(.prose h2[id="本章目录"]),
    .agent-learning :global(.prose h2[id="本章目录"] + ul) { display: block; }
  }
</style>
